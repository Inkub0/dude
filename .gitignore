# Doom 3 game data — copyrighted, must never be committed.
# base/ keeps its tracked upstream .cfg files; only the data/keys are ignored.
*.pk4
/base/doomkey
/base/xpkey
/base/DoomConfig.cfg
/base/*.dat
/d3xp/
/d3le/
savegames/
/base/generated/
/base/screenshots/
/base/maps/
# base/guis: only CLEAN DUDE-authored gui text may be tracked. mpmain.gui stays
# repo-local (id/CstDoom3-derivative multiplayer menu, out of git like the pk4s,
# mirrored into fs_savepath at startup); binary GUI assets (tga etc.) ship via
# the assets channel. mainmenu.gui is tracked by choice despite its
# id/CstDoom3-derivative history — strip it before an engine-only publish if
# that provenance ever matters.
/base/guis/*
!/base/guis/*.gui
!/base/guis/*.pd
!/base/guis/dude/
/base/guis/mpmain.gui
*.pk4.orig
*.pk4.bak
*.pkZZ

# generated at runtime (Vulkan driver pipeline cache, written to fs_savepath/base)
vkpipelinecache.bin

# stray/personal files at the repo root (not project content)
/-l
/Modelfile
/tfphobos
