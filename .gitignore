# harvested shader corpus (copyrighted game/mod content)
/testdata/

# Doom 3 game data — copyrighted, must never be committed.
# base/ keeps its tracked upstream .cfg files; only the data/keys are ignored.
*.pk4
/base/doomkey
/base/xpkey
/base/DoomConfig.cfg
/base/*.dat
/d3xp/
/d3le/
savegames/
/base/generated/
/base/screenshots/
/base/maps/
# base/guis: only CLEAN DUDE-authored gui text may be tracked. The working
# mainmenu.gui/mpmain.gui are id/CstDoom3-derivative game data — they stay
# repo-local (the engine mirrors them into fs_savepath at startup) and out of
# git like the pk4s; binary GUI assets (tga etc.) ship via the assets channel.
/base/guis/*
!/base/guis/*.gui
!/base/guis/*.pd
/base/guis/mainmenu.gui
/base/guis/mpmain.gui
*.pk4.orig
*.pk4.bak
*.pkZZ

# generated at runtime (Vulkan driver pipeline cache, written to fs_savepath/base)
vkpipelinecache.bin

# stray/personal files at the repo root (not project content)
/-l
/Modelfile
/tfphobos
