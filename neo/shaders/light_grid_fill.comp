// DUDE RT light-grid FILL (docs/rtx-light-grid.md L1): one thread per grid cell, once per frame AFTER the scene-light
// buffer is gathered and BEFORE the DI gather / bounce that consume it (RhiWorld.cpp RB_RHI_LightGridFill). For each
// cell: stream every scene light, importance = flux x geometry at the cell centre, and DETERMINISTICALLY keep the `slots`
// HIGHEST-importance in-range lights (a streaming top-N), plus the sum of the kept importances (the consume pdf
// denominator). Deterministic = no rng, so the grid is STABLE frame-to-frame for a static camera (no flicker); the
// per-pixel CONSUME does the importance-proportional draw instead. When a cell has <= slots in-range lights it keeps them
// ALL = the exact in-range set (lossless, exhaustive-equivalent at fixed cost); only a cell with MORE drops its dimmest.
// The grid is DENSE and rewritten whole every frame (no clear, no history; L4's feedback would add temporal learning).
// An out-of-range / lightless cell writes count 0 and the consumer falls back to its old path.
#extension GL_EXT_buffer_reference_uvec2 : require

// rt_light_eval.glsl: RtLight / RtLights / DUDE_LIGHT_* / dudeLightInRange. rtgi_light_grid.glsl: LgGrid + mapping + layout.
#include "rt_light_eval.glsl"
#include "rtgi_light_grid.glsl"

#define LG_MAX_SLOTS 16u			// fixed reservoir array size; r_rtLightGridSlots is clamped to this

layout( local_size_x = 64 ) in;

layout( push_constant ) uniform PC {
	uint  gridLo, gridHi;			// grid buffer device address
	uint  lightLo, lightHi;			// scene-light buffer device address
	uint  nLights;					// lights in the buffer (fog rows excluded by the CPU count)
	uint  cascades, res, slots;		// grid dimensions (slots <= LG_MAX_SLOTS)
	float cellBase;					// cascade-0 cell size (units)
	float camX, camY, camZ;			// camera position (cascade snapping)
	float parallelFlux;				// flux weight for parallel (sun) lights, which have no 1/d^2 term
	uint  frame;					// frame index: the residual slots' sampling seed (a fresh draw every frame)
} pc;

void main() {
	uint cellIndex = gl_GlobalInvocationID.x;
	uint total = pc.cascades * pc.res * pc.res * pc.res;
	if ( cellIndex >= total ) { return; }
	const bool cellLive = true;

	LgGrid   grid   = LgGrid( uvec2( pc.gridLo, pc.gridHi ) );
	RtLights lights = RtLights( uvec2( pc.lightLo, pc.lightHi ) );
	uint     slots  = min( pc.slots, LG_MAX_SLOTS );
	int      base   = int( cellIndex * lgStride( slots ) );

	vec3  camPos = vec3( pc.camX, pc.camY, pc.camZ );
	int   c;
	vec3  center = lgCellCenter( cellIndex, camPos, pc.cellBase, int( pc.res ), c );
	float cs     = pc.cellBase * float( 1 << c );
	float cellHalfDiag = cs * 0.8660254;	// sqrt(3)/2 * cell size: a light reaching any corner is a candidate

	uint  chosen[ LG_MAX_SLOTS ];
	float chosenImp[ LG_MAX_SLOTS ];
	uint  count   = 0u;				// kept so far (up to slotsL)
	uint  minSlot = 0u;				// the weakest kept slot, for replacement once full
	float minImp  = 1e30;
	// E2 v3: a BOUNCEONLY emitter row (normal mode + r_rtEmissiveBounce) is a candidate for the GI bounce only - the DI
	// shade skips it - so it must never DISPLACE a placed light: it gets its own small quota of the slots (2 of 16), ranked
	// among its kind. Ranking the 300 emitter rows of a map against the placed lights for the same slots emptied whole
	// cells of their placed lights and the DI changed from cell to cell: the blocky shadows of 2026-10-20.
	uint  quotaB  = ( slots >= 8u ) ? 2u : ( ( slots >= 4u ) ? 1u : 0u );
	uint  slotsL  = slots - quotaB;	// the placed lights' (and, in emissive mode, the emitter lights') share
	uint  chosenB[ 2 ];
	float chosenImpB[ 2 ];
	uint  countB  = 0u, minSlotB = 0u;
	float minImpB = 1e30;
	uint  nIn     = 0u;				// in-range light candidates seen (more than slotsL = the cell OVERFLOWS)

	for ( uint li = 0u; li < pc.nLights; li++ ) {
		uint flags = lights.l[ li ].flags;
		// skip fog rows (not lights) AND DIFORWARD lights (the fast first-person weapon lights / flashlight): the DI
		// gather's diShadeLight skips DIFORWARD unconditionally (restir_di_shade.glsl - the forward path lights them),
		// so the grid's candidate set must match it, and excluding the moving flashlight also stops it churning cells.
		if ( ( flags & ( DUDE_LIGHT_FOGVOLUME | DUDE_LIGHT_DIFORWARD ) ) != 0u ) { continue; }
		// (E2 v3: an EMITTER row ranks like any light - its colour is the irradiance proxy at its reach, its radius the
		// reach - including the BOUNCEONLY rows of normal mode, which the DI shade skips and the bounce uses)
		// in-range: the cell centre within the light's cull sphere, widened by the cell half-diagonal
		vec4 cull = lights.l[ li ].cull;
		vec3 cd   = cull.xyz - center;
		float rr  = cull.w + cellHalfDiag;
		if ( dot( cd, cd ) > rr * rr ) { continue; }
		// importance = flux * geometry. flux = emitted power proxy (luminance x reach); geom = inverse-square (clamped
		// to the cell extent). Parallel suns have no distance term - a fixed flux weight keeps them a candidate everywhere.
		float lum = dot( lights.l[ li ].color, vec3( 0.2126, 0.7152, 0.0722 ) );
		if ( lum <= 0.0 ) { continue; }
		float imp;
		if ( ( flags & DUDE_LIGHT_PARALLEL ) != 0u ) {
			imp = lum * pc.parallelFlux;
		} else {
			float rad  = max( lights.l[ li ].radius, 1.0 );
			vec3  pd   = center - lights.l[ li ].pos;
			float d2   = max( dot( pd, pd ), cs * cs );
			imp = lum * ( rad * rad ) / d2;
		}
		if ( imp <= 0.0 ) { continue; }
		if ( ( flags & DUDE_LIGHT_BOUNCEONLY ) != 0u ) {
			if ( quotaB == 0u ) { continue; }
			if ( countB < quotaB ) {
				chosenB[ countB ] = li; chosenImpB[ countB ] = imp; countB++;
				if ( countB == quotaB ) {
					minImpB = chosenImpB[ 0 ]; minSlotB = 0u;
					for ( uint k = 1u; k < quotaB; k++ ) { if ( chosenImpB[ k ] < minImpB ) { minImpB = chosenImpB[ k ]; minSlotB = k; } }
				}
			} else if ( imp > minImpB ) {
				chosenB[ minSlotB ] = li; chosenImpB[ minSlotB ] = imp;
				minImpB = chosenImpB[ 0 ]; minSlotB = 0u;
				for ( uint k = 1u; k < quotaB; k++ ) { if ( chosenImpB[ k ] < minImpB ) { minImpB = chosenImpB[ k ]; minSlotB = k; } }
			}
			continue;
		}
		nIn++;
		// streaming TOP-N by importance (deterministic - no rng, so the grid is stable frame-to-frame)
		if ( count < slotsL ) {
			chosen[ count ] = li;
			chosenImp[ count ] = imp;
			count++;
			if ( count == slotsL ) {									// just filled: locate the weakest kept slot
				minImp = chosenImp[ 0 ]; minSlot = 0u;
				for ( uint k = 1u; k < slotsL; k++ ) { if ( chosenImp[ k ] < minImp ) { minImp = chosenImp[ k ]; minSlot = k; } }
			}
		} else if ( imp > minImp ) {									// stronger than the weakest kept: replace it, re-find the weakest
			chosen[ minSlot ] = li;
			chosenImp[ minSlot ] = imp;
			minImp = chosenImp[ 0 ]; minSlot = 0u;
			for ( uint k = 1u; k < slotsL; k++ ) { if ( chosenImp[ k ] < minImp ) { minImp = chosenImp[ k ]; minSlot = k; } }
		}
	}
	// Per slot the record stores the light index and its SELECTION WEIGHT q: 1 for a deterministically kept light (the
	// consumer treats it as a pdf-1 candidate), q < 1 for a RESIDUAL slot (below). The consumer divides by q.
	float chosenQ[ LG_MAX_SLOTS ];
	for ( uint k = 0u; k < LG_MAX_SLOTS; k++ ) { chosenQ[ k ] = 1.0; }
	float sumStored = 0.0;
	for ( uint k = 0u; k < count; k++ ) { sumStored += chosenImp[ k ]; }

	// OVERFLOW (ReGIR proper, docs/rtx-light-grid.md): a cell with MORE in-range lights than slots - emissive mode's 300
	// emitter rows reaching two radii put a hundred into every cell - used to keep the top slotsL and silently DROP the
	// rest, so neighbouring cells kept different sets and the lighting stepped at every cell border (the blocky shadows
	// of 2026-10-20). Now the weakest kS deterministic slots become RESIDUAL slots: kS independent draws from every
	// in-range light outside the kept set, in proportion to importance (weighted reservoir sampling, a fresh draw each
	// frame), stored with q = kS x imp / sumRest. The consumer weighs such a candidate by pHat / q: an unbiased estimate
	// of everything the cell cannot hold, as noise the denoiser averages instead of a step. A cell that fits is unchanged.
	if ( nIn > slotsL && slotsL >= 4u ) {
		uint  kS = max( slotsL / 4u, 1u );
		uint  nKeep = slotsL - kS;
		// drop the weakest kS of the kept set (selection by repeated min extraction; <= 16 entries)
		for ( uint drop = 0u; drop < kS; drop++ ) {
			uint  wk = 0u;
			for ( uint k = 1u; k < count; k++ ) { if ( chosenImp[ k ] < chosenImp[ wk ] ) { wk = k; } }
			count--;
			chosen[ wk ] = chosen[ count ]; chosenImp[ wk ] = chosenImp[ count ];
		}
		// kS reservoirs over the residual (everything in range not in the kept set)
		uint  resL[ 4 ];
		float resImp[ 4 ];
		float resW[ 4 ];
		uint  rng[ 4 ];
		for ( uint j = 0u; j < 4u; j++ ) { resL[ j ] = 0u; resImp[ j ] = 0.0; resW[ j ] = 0.0; rng[ j ] = lgPcg( cellIndex * 9781u + pc.frame * 6271u + j * 7919u ) | 1u; }
		float sumRest = 0.0;
		for ( uint li = 0u; li < pc.nLights; li++ ) {
			uint flags = lights.l[ li ].flags;
			if ( ( flags & ( DUDE_LIGHT_FOGVOLUME | DUDE_LIGHT_DIFORWARD | DUDE_LIGHT_BOUNCEONLY ) ) != 0u ) { continue; }
			vec4 cull = lights.l[ li ].cull;
			vec3 cd   = cull.xyz - center;
			float rr  = cull.w + cellHalfDiag;
			if ( dot( cd, cd ) > rr * rr ) { continue; }
			float lum = dot( lights.l[ li ].color, vec3( 0.2126, 0.7152, 0.0722 ) );
			if ( lum <= 0.0 ) { continue; }
			float imp;
			if ( ( flags & DUDE_LIGHT_PARALLEL ) != 0u ) {
				imp = lum * pc.parallelFlux;
			} else {
				float rad  = max( lights.l[ li ].radius, 1.0 );
				vec3  pd   = center - lights.l[ li ].pos;
				float d2   = max( dot( pd, pd ), cs * cs );
				imp = lum * ( rad * rad ) / d2;
			}
			if ( imp <= 0.0 ) { continue; }
			bool kept = false;
			for ( uint k = 0u; k < count; k++ ) { if ( chosen[ k ] == li ) { kept = true; break; } }
			if ( kept ) { continue; }
			sumRest += imp;
			for ( uint j = 0u; j < kS; j++ ) {
				resW[ j ] += imp;
				if ( lgRand( rng[ j ] ) * resW[ j ] < imp ) { resL[ j ] = li; resImp[ j ] = imp; }
			}
		}
		if ( sumRest > 0.0 ) {
			for ( uint j = 0u; j < kS && count < slotsL; j++ ) {
				if ( !( resImp[ j ] > 0.0 ) ) { continue; }
				chosen[ count ] = resL[ j ];
				chosenImp[ count ] = resImp[ j ];
				chosenQ[ count ] = min( float( kS ) * resImp[ j ] / sumRest, 1.0 );
				count++;
			}
		}
		sumStored = 0.0;
		for ( uint k = 0u; k < nKeep && k < count; k++ ) { sumStored += chosenImp[ k ]; }
		sumStored += sumRest;													// the cell's total in-range importance (debug view 3)
	}

	// the bounce-only rows ride behind the lights in the same record (their quota never exceeds the free slots)
	for ( uint k = 0u; k < countB && count < slots; k++ ) { chosen[ count ] = chosenB[ k ]; chosenImp[ count ] = chosenImpB[ k ]; chosenQ[ count ] = 1.0; count++; }

	if ( cellLive && count > 0u ) {
		grid.g[ base ]     = count;
		grid.g[ base + 1 ] = floatBitsToUint( sumStored );
		for ( uint k = 0u; k < count; k++ ) {
			grid.g[ base + int( LG_HEADER + 2u * k ) ]      = chosen[ k ];
			grid.g[ base + int( LG_HEADER + 2u * k + 1u ) ] = floatBitsToUint( chosenQ[ k ] );		// the selection weight q (1 = kept outright)
		}
	} else if ( cellLive ) {
		grid.g[ base ] = 0u;											// no in-range light: empty, the consumer falls back
	}
}
