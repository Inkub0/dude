// DUDE RT irradiance cache RESOLVE (docs/rtx-irradiance-cache.md C1): one thread per cache slot, once per frame
// after the gather(s) that fed the accumulation buffer (RhiWorld.cpp RB_RHI_RtgiCacheResolve). For every slot whose
// accumulation entry received samples this frame: fold their mean into the cell's running estimate with
// alpha = max( 1 / N, alphaMin ) - a cell's first samples replace it outright, a converged cell keeps at least
// alphaMin of the fresh frame so a lighting change never takes more than ~1/alphaMin frames to show - cap the
// history at Nmax (r_rtgiCacheHistory), and clear the sums for the next frame. A RESET request (bit 31 of the count,
// set by an evicting writer or by the DI gradient pass on a lighting change) restarts the cell: N = 0, the stale mean
// is dropped. mode 1 = CLEAR: zero every slot and accumulation entry (first use, level change, slot-count change).
//
// Bound as compute storage bindings (ComputeArgs::storage[0] = slots, [1] = accumulation); the push constants carry
// the slot count, the mode, Nmax, the frame and alphaMin. The layouts are rtgi_cache.glsl's (shared with the
// fragment side, which addresses the same buffers by device address).
#extension GL_EXT_buffer_reference_uvec2 : require

#define RTGI_CACHE_NO_UNIFORMS 1	// bound storage, no RenderParams block here
#include "rt_hash_grid.glsl"
#include "rtgi_cache.glsl"

layout( local_size_x = 256 ) in;

layout( std430, binding = 0 ) buffer CacheSlots  { HgSlot  s[]; } slots;
layout( std430, binding = 1 ) buffer CacheAccums { HgAccum a[]; } accum;

layout( push_constant ) uniform PC {
	uint  slotCount;	// slots in the buffers (power of two)
	uint  mode;			// 0 = resolve, 1 = clear
	uint  nMax;			// history cap (frames of memory per cell)
	uint  frame;		// this frame's stamp (unused by the resolve itself; kept for symmetry with the fragment side)
	float alphaMin;		// floor on the blend factor (responsiveness)
} pc;

void main() {
	uint i = gl_GlobalInvocationID.x;
	if ( i >= pc.slotCount ) { return; }
	if ( pc.mode == 1u ) {
		slots.s[ i ] = HgSlot( 0u, 0u, 0u, 0u );
		accum.a[ i ] = HgAccum( 0u, 0u, 0u, 0u );
		return;
	}
	HgAccum acc = accum.a[ i ];
	uint cnt   = acc.count & RTGI_CACHE_COUNT_MASK;
	bool reset = ( acc.count & RTGI_CACHE_RESET_BIT ) != 0u;
	if ( cnt == 0u && !reset ) { return; }									// untouched this frame: nothing to do (the common case)
	accum.a[ i ] = HgAccum( 0u, 0u, 0u, 0u );
	HgSlot sl = slots.s[ i ];
	if ( sl.key == 0u ) { return; }											// no cell owns the slot (a stale reset): drop the sums
	vec3 irr   = rtgiCacheUnpackIrr( sl );
	uint N     = reset ? 0u : rtgiCacheN( sl );
	uint flags = RTGI_CACHE_RESET_FLAG;										// a reset request with no samples: restarts on its next sample
	if ( cnt > 0u ) {
		vec3  mean  = vec3( float( acc.r ), float( acc.g ), float( acc.b ) ) * ( 1.0 / ( RTGI_CACHE_FIXED * float( cnt ) ) );
		float alpha = max( 1.0 / float( N + 1u ), pc.alphaMin );
		irr = ( N == 0u ) ? mean : mix( irr, mean, alpha );
		// activity flags for the debug view (r_rtgiCacheDebug 5): RESET when the cell restarted on request, FRESH when it
		// was created this frame (N 0 -> 1) or seeded from its coarser parent (the gather's SEEDED bit, consumed here)
		flags = reset ? RTGI_CACHE_RESET_FLAG
		      : ( ( N == 0u || ( sl.irrBN & RTGI_CACHE_SEEDED_BIT ) != 0u ) ? RTGI_CACHE_FRESH_BIT : 0u );
		N = min( N + 1u, clamp( pc.nMax, 1u, RTGI_CACHE_N_MAX ) );
	}
	rtgiCachePackIrr( sl, irr, N, flags );
	slots.s[ i ] = sl;
}
