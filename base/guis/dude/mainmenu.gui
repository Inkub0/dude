					transition "optSideBar::backcolor" "0.45 0.55 0.7 0.2" "0.45 0.55 0.7 0.35" "300" ;
					resetTime "tipTop" "0" ;
					set "tipTop::text" "#str_02206" ;
					set "tipBottom::text" "#str_02206" ;
				}
