	// ---- tooltip pair: hover-in resets tipTop (shows), hover-out resets
	//      tipBottom (hides); both mirror the same text top and bottom ----
	windowDef tipTop {
		rect		17, 0, 0, 12
		cstAnchor	CST_ANCHOR_CENTER_CENTER
		text		"#str_01997"
		font		"fonts/bank"
		textscale	0.25
		forecolor	1, 1, 1, 0
		notime		1
		noevents	1
		textaligny	-7
		visible		0

		onTime 0 {
			set "tipBottom::tipoff" "0" ;
			transition "rect" "17 0 0 12" "17 0 370 12" "150" ;
			transition "tipBottom::rect" "17 470 0 10" "17 470 370 10" "150" ;
			transition "forecolor" "1 1 1 0.5" "1 1 1 0.2" "250" ;
			transition "tipBottom::forecolor" "1 1 1 0.5" "1 1 1 0.2" "250" ;
		}
	}
	windowDef tipBottom {
		rect		17, 470, 0, 10
		cstAnchor	CST_ANCHOR_CENTER_CENTER
		text		"#str_01998"
		font		"fonts/bank"
		textscale	0.25
		forecolor	1, 1, 1, 0
		notime		1
		noevents	1
		float tipoff	1
		textaligny	-9

		onTime 0 {
			set "tipoff" "1" ;
			transition "tipTop::rect" "17 0 370 12" "17 0 0 12" "50" ;
			transition "rect" "17 470 370 10" "17 470 0 10" "50" ;
			transition "forecolor" "1 1 1 0.3" "1 1 1 0" "50" ;
			transition "tipTop::forecolor" "1 1 1 0.3" "1 1 1 0" "50" ;
		}
		onTime 250 {
			if ("tipoff" == 1) {
				set "rect" "17 -7 0 19" ;
				set "tipTop::rect" "17 461 0 19" ;
				set "forecolor" "1 1 1 0" ;
				set "tipTop::forecolor" "1 1 1 0" ;
			}
		}
	}

	// ---- boot fade: modal black cover, released by the bgMars choreography ----
	windowDef bootFade {
		rect		0, 0, 640, 480
		backcolor	0, 0, 0, 1
		modal		1
	}
}
