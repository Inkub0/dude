			rect		27, 410, 32, 32
			noevents	1

			windowDef ngEdgeLGray {
				rect		0, 0, 32, 32
				background	"gui/mainmenu/button_edge"
				matcolor	0.45, 0.45, 0.45, 0.3
				noevents	1
				visible		("gui::inGame" == 2)
			}
			windowDef ngEdgeLBase {
