			onMouseExit {
				if ("desktop::selected" == 1) {
					resetTime "tipBottom" "0" ;
				} else {
					if ("exitanim" == 1) {
						set "exitanim" "0" ;
						transition "forecolor" "1 1 1 1" "1 1 1 0.4" "200" ;
						transition "optLoCornerL::matcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optLoBar::backcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optLoCornerR::matcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optMidBar::backcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optMidCorner::matcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optTopCornerL::matcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optTopBar::backcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optTopCornerR::matcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
						transition "optSideBar::backcolor" "0.45 0.55 0.7 0.3" "0.45 0.55 0.7 0.2" "300" ;
					}
					resetTime "tipBottom" "0" ;
				}
			}

			onAction {
				set "exitanim" "0" ;
				if ("desktop::selected" == 1) {
					set "cmd" "play guisounds_menuclickdown" ;
					resetTime "animOptionsToMain" "0" ;
					set "desktop::selected" "0" ;
					transition "forecolor" "1 1 1 0.1" "1 1 1 0.4" "200" ;
					transition "dudeSettingsBtn::rect" "255, 443, 100, 16" "233, 443, 100, 16" "300" ;
				} else {
					transition "dudeSettingsBtn::rect" "233, 443, 100, 16" "255, 443, 100, 16" "300" ;
					transition "forecolor" "1 1 1 1" "1 1 1 0.1" "200" ;
					set "cmd" "play guisounds_menuclickup" ;
					if ("desktop::selected" == 2) {
						resetTime "animNGToMain" "0" ;
					}
					if ("desktop::selected" == 3) {
						resetTime "animLGToMain" "0" ;
						resetTime "logoShow" "0" ;
						resetTime "topBarSlideIn" "0" ;
					}
					if ("desktop::selected" == 4) {
						resetTime "animMPToMain" "0" ;
					}
					if ("desktop::selected" == 6) {
						resetTime "animSGToMain" "0" ;
						resetTime "logoShow" "0" ;
						resetTime "topBarSlideIn" "0" ;
					}
					if ("desktop::selected" == 7) {
						resetTime "animModsDown" "0" ;
						resetTime "logoShow" "0" ;
						resetTime "topBarSlideIn" "0" ;
					}
					resetTime "animMainToOptions" "0" ;
					set "desktop::selected" "1" ;
					if ("logoHide::logo" == 0) {
						resetTime "logoShow" "0" ;
					}
				}
			}
		}

