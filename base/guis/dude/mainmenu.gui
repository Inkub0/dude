					transition "mpEdgeRGlow::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
					transition "mpEdgeLHi::matcolor" "1 1 1 0" "0.55 0.65 0.75 0.5" "200" ;
					transition "mpMidHi::matcolor" "1 1 1 0" "0.55 0.65 0.75 0.5" "200" ;
					transition "mpEdgeRHi::matcolor" "1 1 1 0" "0.55 0.65 0.75 0.5" "200" ;
					transition "mpEdgeLHi::rect" "0 0 32 32" "7 3 26 26" "300" "0" "0.9" ;
					transition "mpMidHi::rect" "0 0 166 32" "0 3 166 26" "300" "0" "0.9" ;
					transition "mpEdgeRHi::rect" "0 0 -32 -32" "-1 3 -26 -26" "300" "0" "0.9" ;
					transition "forecolor" "1 1 1 1" "1 1 1 1" "200" ;
					resetTime "tipTop" "0" ;
					set "tipTop::text" "#str_02215" ;
					set "tipBottom::text" "#str_02215" ;
				}
			}

			onMouseExit {
				if ("desktop::selected" == 0) {
					if ("exitanim" == 1) {
						set "exitanim" "0" ;
						transition "mpEdgeLGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
						transition "mpMidGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
						transition "mpEdgeRGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
						transition "mpEdgeLHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
						transition "mpMidHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
						transition "mpEdgeRHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
					}
					resetTime "tipBottom" "0" ;
				} else {
					if ("desktop::selected" == 4) {
						resetTime "tipBottom" "0" ;
					} else {
						if ("exitanim" == 1) {
							set "exitanim" "0" ;
							transition "mpEdgeLGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0" "400" ;
							transition "mpMidGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0" "400" ;
							transition "mpEdgeRGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0" "400" ;
							transition "mpEdgeLHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "500" "0" "0.6" ;
							transition "mpMidHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "500" "0" "0.6" ;
							transition "mpEdgeRHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "500" "0" "0.6" ;
							transition "forecolor" "1 1 1 1" "1 1 1 0.5" "200" ;
						}
						resetTime "tipBottom" "0" ;
					}
				}
			}

			onAction {
				set "exitanim" "0" ;
				if ("desktop::selected" == 4) {
					set "cmd" "play guisounds_menuclickdown" ;
					resetTime "animMPToMain" "0" ;
					set "desktop::selected" "0" ;
					transition "forecolor" "1 1 1 0.1" "1 1 1 1" "200" ;
				} else {
					transition "forecolor" "1 1 1 1" "1 1 1 0.1" "200" ;
					set "cmd" "play guisounds_menuclickup" ;
					if ("desktop::selected" == 1) {
						resetTime "animOptionsToMain" "0" ;
					}
					if ("desktop::selected" == 2) {
						resetTime "animNGToMain" "0" ;
					}
					if ("desktop::selected" == 3) {
						resetTime "animLGToMain" "0" ;
					}
					if ("desktop::selected" == 7) {
						resetTime "animModsDown" "0" ;
					}
					resetTime "animMainToMP" "0" ;
					set "desktop::selected" "4" ;
					if ("logoHide::logo" == 0) {
						resetTime "logoShow" "0" ;
					}
				}
			}
		}

		// ---- Stop Game (text; same plate as Multiplayer, in-game only) ----
		windowDef navStopGameText {
			rect		435, 415, 180, 21
			text		"#str_02216"
			textscale	0.26
			textalign	1
			textaligny	1
			forecolor	1, 1, 1, 1
			float "mouseout" 0
			visible		("gui::inGame" == 1)

			onMouseEnter {
				transition "mpEdgeLGlow::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
				transition "mpMidGlow::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
				transition "mpEdgeRGlow::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
				transition "mpEdgeLHi::matcolor" "1 1 1 0" "0.55 0.65 0.75 0.5" "200" ;
				transition "mpMidHi::matcolor" "1 1 1 0" "0.55 0.65 0.75 0.5" "200" ;
				transition "mpEdgeRHi::matcolor" "1 1 1 0" "0.55 0.65 0.75 0.5" "200" ;
				transition "mpEdgeLHi::rect" "0 0 32 32" "7 3 26 26" "300" "0" "0.9" ;
				transition "mpMidHi::rect" "0 0 166 32" "0 3 166 26" "300" "0" "0.9" ;
				transition "mpEdgeRHi::rect" "0 0 -32 -32" "-1 3 -26 -26" "300" "0" "0.9" ;
				transition "forecolor" "1 1 1 1" "1 1 1 1" "200" ;
				resetTime "tipTop" "0" ;
				set "tipTop::text" "#str_02217" ;
				set "tipBottom::text" "#str_02217" ;
				set "mouseout" "1" ;
			}

			onMouseExit {
				if ("desktop::selected" == 0) {
					if ("mouseout" == 1) {
						set "mouseout" "0" ;
						transition "mpEdgeLGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
						transition "mpMidGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
						transition "mpEdgeRGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
						transition "mpEdgeLHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
						transition "mpMidHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
						transition "mpEdgeRHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
					}
					resetTime "tipBottom" "0" ;
				} else {
					if ("mouseout" == 1) {
						set "mouseout" "0" ;
						transition "mpEdgeLGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0" "400" ;
						transition "mpMidGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0" "400" ;
						transition "mpEdgeRGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0" "400" ;
						transition "mpEdgeLHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "500" "0" "0.6" ;
						transition "mpMidHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "500" "0" "0.6" ;
						transition "mpEdgeRHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "500" "0" "0.6" ;
						transition "forecolor" "1 1 1 1" "1 1 1 0.5" "200" ;
					}
					resetTime "tipBottom" "0" ;
				}
			}

			onAction {
				if ("desktop::selected" == 1) {
					resetTime "animOptionsToMain" "0" ;
				}
				if ("desktop::selected" == 3) {
					resetTime "animLGToMain" "0" ;
				}
				if ("desktop::selected" == 6) {
					resetTime "animSGToMain" "0" ;
				}
				if ("desktop::selected" == 7) {
					resetTime "animModsDown" "0" ;
				}
				set "desktop::selected" "8" ;
				set "cmd" "play guisounds_menuclickup" ;
				resetTime "animQTMUp" "0" ;
				set "mouseout" "0" ;
				transition "mpEdgeLGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
				transition "mpMidGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
				transition "mpEdgeRGlow::matcolor" "0.55 0.65 0.75 1" "0.55 0.65 0.75 0.5" "400" ;
				transition "mpEdgeLHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
				transition "mpMidHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
				transition "mpEdgeRHi::matcolor" "0.55 0.65 0.75 0.5" "1 1 1 0" "400" ;
				resetTime "tipBottom" "0" ;
			}
		}

		// ---- bottom-right utility row ----
		windowDef navReturnText {
			rect		420, 454, 140, 22
			text		"#str_04106"
			textscale	0.26
			textalign	1
			textaligny	2
			forecolor	1, 1, 1, 0.4
			visible		("gui::inGame" != 0)

			onMouseEnter {
				transition "forecolor" "1 1 1 0.4" "1 1 1 1" "100" ;
				resetTime "tipTop" "0" ;
				set "tipTop::text" "#str_04107" ;
				set "tipBottom::text" "#str_04107" ;
			}
			onMouseExit {
				transition "forecolor" "0.8 0.95 1 1" "1 1 1 0.4" "200" ;
				resetTime "tipBottom" "0" ;
			}
			onAction {
				set "cmd" "play guisounds_menuclickup" ;
			}
			onActionRelease {
				set "cmd" "close" ;
			}
		}

		windowDef navModsText {
			rect		384, 454, 50, 22
			text		"#str_04098"
			textscale	0.25
			textalign	1
			textaligny	2
			forecolor	1, 1, 1, 0.4
			visible		("gui::inGame" == 0)

			onMouseEnter {
				transition "forecolor" "1 1 1 0.4" "1 1 1 1" "100" ;
				resetTime "tipTop" "0" ;
				set "tipTop::text" "#str_04108" ;
				set "tipBottom::text" "#str_04108" ;
			}
			onMouseExit {
				transition "forecolor" "0.8 0.95 1 1" "1 1 1 0.4" "200" ;
				resetTime "tipBottom" "0" ;
			}
			onAction {
				if ("desktop::selected" == 7) {
					set "cmd" "play guisounds_menuclickdown" ;
					resetTime "animModsDown" "0" ;
					set "desktop::selected" "0" ;
				} else {
					set "cmd" "play guisounds_menuclickup" ;
					if ("desktop::selected" == 1) {
						resetTime "animOptionsToMain" "0" ;
					}
					if ("desktop::selected" == 2) {
						resetTime "animNGToMain" "0" ;
					}
					if ("desktop::selected" == 3) {
						resetTime "animLGToMain" "0" ;
					}
					if ("desktop::selected" == 4) {
						resetTime "animMPToMain" "0" ;
					}
					if ("desktop::selected" == 6) {
						resetTime "animSGToMain" "0" ;
					}
					set "cmd" "play guisounds_chirpconnect" ;
					set "desktop::selected" "7" ;
					resetTime "animModsUp" "0" ;
				}
			}
		}

		windowDef navUpdatesText {
			rect		441, 454, 73, 22
			text		"#str_04837"
			textscale	0.25
			textalign	1
			textaligny	2
			forecolor	1, 1, 1, 0.4
			visible		("gui::inGame" == 0)
			notime		1

			onMouseEnter {
				transition "forecolor" "1 1 1 0.4" "1 1 1 1" "100" ;
				resetTime "tipTop" "0" ;
				set "tipTop::text" "#str_04838" ;
				set "tipBottom::text" "#str_04838" ;
			}
			onMouseExit {
				transition "forecolor" "0.8 0.95 1 1" "1 1 1 0.4" "200" ;
				resetTime "tipBottom" "0" ;
			}
			onAction {
				set "cmd" "play guisounds_menuclickup ; CheckUpdate2" ;
				resetTime "tipBottom" "0" ;
				transition "forecolor" "0.8 0.95 1 1" "1 1 1 0.4" "200" ;
				set "noevents" "1" ;
				resetTime "0" ;
			}
			// cooldown before the button accepts another update check
			onTime 5000 {
				set "noevents" "0" ;
			}
		}

		windowDef navCreditsText {
			rect		522, 454, 65, 22
			text		"#str_02218"
			textscale	0.25
			textalign	1
			textaligny	2
			forecolor	1, 1, 1, 0.4
			visible		("gui::inGame" == 0)

			onMouseEnter {
				transition "forecolor" "1 1 1 0.4" "1 1 1 1" "100" ;
				resetTime "tipTop" "0" ;
				set "tipTop::text" "#str_02219" ;
				set "tipBottom::text" "#str_02219" ;
			}
			onMouseExit {
				transition "forecolor" "0.8 0.95 1 1" "1 1 1 0.4" "200" ;
				resetTime "tipBottom" "0" ;
			}
			onAction {
				if ("desktop::selected" == 1) {
					resetTime "animOptionsToMain" "0" ;
				}
				if ("desktop::selected" == 2) {
					resetTime "animNGToMain" "0" ;
				}
				if ("desktop::selected" == 3) {
					resetTime "animLGToMain" "0" ;
				}
				if ("desktop::selected" == 4) {
					resetTime "animMPToMain" "0" ;
				}
				if ("desktop::selected" == 6) {
					resetTime "animSGToMain" "0" ;
				}
				if ("desktop::selected" == 7) {
					resetTime "animModsDown" "0" ;
				}
				transition "navOptionsText::forecolor" "1 1 1 1" "1 1 1 0.4" "200" ;
				transition "navNewGameText::forecolor" "1 1 1 1" "1 1 1 1" "200" ;
				transition "navLoadText::forecolor" "1 1 1 1" "1 1 1 1" "200" ;
				transition "navMultiplayerText::forecolor" "1 1 1 0.5" "1 1 1 1" "200" ;
				set "cmd" "play guisounds_chirpconnect" ;
				set "desktop::selected" "5" ;
				resetTime "animCreditsUp" "0" ;
			}
		}

		windowDef navExitText {
			rect		594, 454, 40, 22
			text		"#str_01248"
			textscale	0.25
			textalign	1
			textaligny	2
			forecolor	1, 1, 1, 0.4

			onMouseEnter {
				transition "forecolor" "1 1 1 0.4" "1 1 1 1" "100" ;
				resetTime "tipTop" "0" ;
				set "tipTop::text" "#str_01976" ;
				set "tipBottom::text" "#str_01976" ;
			}
			onMouseExit {
				transition "forecolor" "0.8 0.95 1 1" "1 1 1 0.4" "200" ;
				resetTime "tipBottom" "0" ;
			}
			onAction {
				set "cmd" "play guisounds_menuclickup" ;
				resetTime "animQOSUp" "0" ;
			}
		}
	}

	// ---- interactive grid FX over the upper screen (id's stock building
	//      blocks: grid2b.pd defines the LineH* windows, grid3b.pd their
	//      mouse-driven glow — both live in pak000) ----
	windowDef gridFX {
		rect		0, 0, 640, 400

		#include "guis/test/grid3b.pd"
	}

	// ---- top border (slides when sub-screens open) ----
	windowDef borderTopBar {
		cstAnchor	CST_ANCHOR_VCENTER
		rect		0, -1, 542, 16
		background	"gui/mainmenu/border_small"
		matcolor	0.45, 0.6, 0.7, 0.2
		noevents	1
	}
	windowDef borderTopCorner {
		cstAnchor	CST_ANCHOR_VCENTER
		rect		542, -1, 128, 128
		background	"gui/mainmenu/border_corner"
		matcolor	0.45, 0.6, 0.7, 0.2
		noevents	1
	}

	// ---- reusable one-shot animation drivers ----
	windowDef logoHide {
		rect		0, 0, 0, 0
		visible		0
		notime		1
		float logo	1

		onTime 0 {
			transition "titleLogo::matcolor" "1 1 1 1" "1 1 1 0" "600" ;
			set "logoHide::logo" "0" ;
		}
	}
	windowDef logoShow {
		rect		0, 0, 0, 0
		visible		0
		notime		1

		onTime 0 {
			transition "titleLogo::matcolor" "1 1 1 0" "1 1 1 1" "600" ;
			set "logoHide::logo" "1" ;
		}
	}
	windowDef topBarSlideOut {
		rect		0, 0, 0, 0
		visible		0
		notime		1

		onTime 0 {
			transition "borderTopBar::rect" "0 -1 542 16" "0 -1 640 16" "300" "9" "0" ;
			transition "borderTopCorner::rect" "542 -1 128 128" "640 -1 128 128" "300" "9" "0" ;
		}
	}
	windowDef topBarSlideIn {
		rect		0, 0, 0, 0
		visible		0
		notime		1

		onTime 0 {
			transition "borderTopBar::rect" "0 -1 640 16" "0 -1 542 16" "300" "0" "9" ;
			transition "borderTopCorner::rect" "640 -1 128 128" "542 -1 128 128" "300" "0" "9" ;
		}
	}

