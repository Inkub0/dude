					transition "optLoBar::backcolor" "0.45 0.55 0.7 0.2" "0.45 0.55 0.7 0.35" "300" ;
					transition "optLoCornerR::matcolor" "0.45 0.55 0.7 0.2" "0.45 0.55 0.7 0.35" "300" ;
					transition "optMidBar::backcolor" "0.45 0.55 0.7 0.2" "0.45 0.55 0.7 0.35" "300" ;
